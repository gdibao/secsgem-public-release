{
  "name": "@ct-claw/fab-cli",
  "version": "2.2.17-chituo.33",
  "private": true,
  "description": "驰拓 AI 助手命令行客户端",
  "homepage": "https://secsgem.com.cn",
  "repository": {
    "type": "git",
    "url": "https://github.com/gdibao/secsgem.com.cn.git"
  },
  "author": "无锡市驰拓信息科技有限公司",
  "type": "module",
  "bin": {
    "chituo": "./dist/index.js",
    "fab": "./dist/index.js",
    "lh": "./dist/index.js",
    "lobe": "./dist/index.js",
    "lobehub": "./dist/index.js"
  },
  "man": [
    "./man/man1/chituo.1",
    "./man/man1/fab.1",
    "./man/man1/lh.1",
    "./man/man1/lobe.1",
    "./man/man1/lobehub.1"
  ],
  "files": [
    "dist",
    "man"
  ],
  "scripts": {
    "build": "bun scripts/ensureWorkspaceLinks.ts && tsdown",
    "cli:link": "bun link",
    "cli:unlink": "bun unlink",
    "dev": "LOBEHUB_CLI_HOME=.lobehub-dev bun src/index.ts",
    "man:generate": "bun src/man/generate.ts",
    "prepublishOnly": "npm run build && npm run man:generate",
    "test": "bunx vitest run --config vitest.config.mts --silent='passed-only'",
    "test:coverage": "bunx vitest run --config vitest.config.mts --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@lobechat/agent-gateway-client": "workspace:*",
    "@lobechat/agent-tracing": "workspace:*",
    "@lobechat/const": "workspace:*",
    "@lobechat/device-control": "workspace:*",
    "@lobechat/device-gateway-client": "workspace:*",
    "@lobechat/device-identity": "workspace:*",
    "@lobechat/eval-rubric": "workspace:*",
    "@lobechat/heterogeneous-agents": "workspace:*",
    "@lobechat/html-artifact": "workspace:*",
    "@lobechat/local-file-shell": "workspace:*",
    "@lobechat/module-app-build": "workspace:*",
    "@lobechat/tool-runtime": "workspace:*",
    "@lobechat/types": "workspace:*",
    "@lobechat/utils": "workspace:*",
    "@trpc/client": "^11.18.0",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "commander": "^13.1.0",
    "dayjs": "^1.11.21",
    "debug": "^4.4.3",
    "diff": "^8.0.4",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "superjson": "^2.2.6",
    "tinyexec": "^1.3.0",
    "tree-kill": "^1.2.2",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "yaml": "^2.8.2",
    "url-join": "^5.0.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "restricted"
  }
