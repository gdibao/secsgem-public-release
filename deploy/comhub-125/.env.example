# Sanitized template; generate secrets ONLY on .125. Never commit .env.
COMHUB_IMAGE=ghcr.io/maheshenga/comhub@sha256:9701ef9da5a5e5606c89196a81b4e1206136c804a6c38be3fb186c219d69bbff
# Public APP_URL is fixed in compose.yaml, not a Docker build-time variable.
# Operator-verified public ingress address; intentionally absent from this template.
FAB_PUBLIC_IP=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AUTH_SECRET=
KEY_VAULTS_SECRET=
JWKS_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Locked by default. Bootstrap real owner under restricted ingress before opening.
AUTH_DISABLE_EMAIL_PASSWORD=1
AUTH_ALLOWED_EMAILS=
AUTH_EMAIL_VERIFICATION=0
# From C125-01 only. Never put credential-bearing URLs here: upstream logs PROXY_URL.
APP_PROXY_URL=
