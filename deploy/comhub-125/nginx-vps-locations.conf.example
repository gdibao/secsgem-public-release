# Insert ONLY into the dedicated fab.gdibao.com HTTPS vhost.
# Replace both REPLACE_* placeholders with C125-02/C125-04 allocated VPS LOOPBACK ports.
# Tunnel destinations: .125 127.0.0.1:3210 and .125 127.0.0.1:19000.
# Never expose the S3 console, PG, Redis, or a wildcard VPS tunnel listener.
# Keep this vhost IP-restricted or maintenance-only until owner bootstrap passes.
client_max_body_size 100m;

location ~ ^/comhub-files(?:/|$) {
    # No trailing slash: preserve bucket path and complete signed query string.
    proxy_pass http://127.0.0.1:REPLACE_S3_TUNNEL_PORT;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 300s;
    access_log off;
}

location / {
    proxy_pass http://127.0.0.1:REPLACE_APP_TUNNEL_PORT;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    # Unconditional upgrade supports websockets; ordinary HTTP remains HTTP/1.1.
    proxy_set_header Connection upgrade;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 600s;
}
