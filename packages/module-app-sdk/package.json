{
  "name": "@lobechat/module-app-sdk",
  "version": "0.1.0",
  "description": "Typed browser SDK for LobeHub Module Apps",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/prepare-package.mjs && node scripts/verify-package.mjs",
    "prepublishOnly": "npm run build",
    "test": "bunx vitest run --silent='passed-only'"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": false,
    "registry": "https://registry.npmjs.org"
  }
}
